# Browser configuration only. Copy to ignored .env.local without overwriting it.
# VITE_ values are public: never put a service-role key or email credential here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_public_supabase_anon_key_here

# Server-only email configuration belongs in supabase/functions/.env.
# See supabase/functions/.env.example and docs/backend-foundation.md.
