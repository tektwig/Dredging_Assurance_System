# Server-side only. Copy to ignored supabase/functions/.env if it does not exist.
# Blank values are intentional; this file must never contain real credentials.
# In hosted environments configure the custom worker settings below as Edge Function secrets.
# Missing optional Waybill client delivery configuration leaves that copy pending;
# driver and trip-closed notifications continue to process.

# Obtain a sending API key from Resend; never use a VITE_ prefix.
RESEND_API_KEY=
# Verified sending address, for example notifications@example.com.
TRIP_NOTIFICATION_FROM=
# Comma-separated authorized recipients, for example finance@example.com.
TRIP_NOTIFICATION_FINANCE_EMAILS=
# Target-company recipient for automatic Waybill PDF delivery. Configure only in
# the server-side Edge Function environment; never use a VITE_ prefix. If blank
# or invalid, the target-company copy stays pending while other mail continues.
WAYBILL_CLIENT_EMAIL=
# Opt-in only for live testing against DEVELOPMENT project pidxlopbxlapfmakmtjt.
# When true, all notification email goes only to tektwig@gmail.com.
WAYBILL_TEST_RECIPIENT_SINK_ENABLED=false
# Generate an independent random secret of at least 32 characters; share only
# with the trusted scheduler, which sends it in the x-worker-secret header.
TRIP_NOTIFICATION_WORKER_SECRET=

# Recommended production ANPR provider. Configure this as a Supabase Edge
# Function secret; never expose it through a VITE_ browser variable.
PLATE_RECOGNIZER_API_TOKEN=

# Optional generic OCR fallback used only when dedicated ANPR is unavailable.
GOOGLE_CLOUD_VISION_API_KEY=

# Generate a separate random secret of at least 32 characters for the trusted
# scheduler that invokes process-waybill-pdfs with x-worker-secret.
WAYBILL_PDF_WORKER_SECRET=

# Also REQUIRED by the implementation, but supplied automatically by the
# Supabase local/hosted Edge Runtime. SUPABASE_ is a reserved secrets prefix.
# These are documentation placeholders, NOT custom secrets to upload/override:
# SUPABASE_URL=http://supabase-runtime-api.example.invalid
# SUPABASE_SERVICE_ROLE_KEY=your_runtime_injected_service_role_key_here
# Never copy either server-side value into browser code or VITE_ settings.
